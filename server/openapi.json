  "components": {
    "securitySchemes": {
      "DeviceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "required": [
          "id",
          "name",
          "make",
          "model",
          "displacementCC",
          "odometerKM"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "abs": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "displacementCC": {
            "type": "number",
            "minimum": 0
          },
          "plate": {
            "type": "string"
          },
          "tyres": {},
          "modifications": {},
          "odometerKM": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Ride": {
        "type": "object",
        "required": [
          "id",
          "vehicleId",
          "startedAt",
          "endedAt",
          "status",
          "source",
          "distanceM",
          "durationS",
          "maxSpeedMPS",
          "meanSpeedMPS",
          "dataVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "recording",
              "paused",
              "finished",
              "interrupted"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "measured",
              "simulated"
            ]
          },
          "distanceM": {
            "type": "number",
            "minimum": 0
          },
          "durationS": {
            "type": "number",
            "minimum": 0
          },
          "maxSpeedMPS": {
            "type": "number",
            "minimum": 0
          },
          "meanSpeedMPS": {
            "type": "number",
            "minimum": 0
          },
          "dataVersion": {
            "type": "integer",
            "minimum": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object"
          }
        }
      },
      "Manual": {
        "type": "object",
        "required": [
          "id",
          "vehicleId",
          "fileName",
          "totalBytes",
          "pageCount",
          "status",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "totalBytes": {
            "type": "integer",
            "maximum": 268435456
          },
          "pageCount": {
            "type": "integer",
            "maximum": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "queued",
              "processing",
              "ready",
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Citation": {
        "type": "object",
        "properties": {
          "manualId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "printedPage": {
            "type": [
              "string",
              "null"
            ]
          },
          "section": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed",
              "unavailable"
            ]
          },
          "dataVersion": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "local"
            ]
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Maintenance": {
        "type": "object",
        "required": [
          "id",
          "vehicleId",
          "performedAt",
          "odometerKM",
          "category",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "performedAt": {
            "type": "string",
            "format": "date-time"
          },
          "odometerKM": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
