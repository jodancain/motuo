    "/v1/rides/{id}/chunks/{sequence}": {
      "put": {
        "summary": "Idempotent SHA-256 raw JSONL upload",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid device token"
          },
          "404": {
            "description": "Resource not visible to this owner"
          },
          "409": {
            "description": "Version, chunk or reference conflict"
          },
          "422": {
            "description": "Checksum, telemetry or file validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sequence",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "description": "UTF-8 JSONL exact bytes (max 4 MiB), verified by X-Content-SHA256. Samples preserve their measurement timestamps; optional stream (location/motion/simulation) and segmentId UUID must appear together. New clients always provide both. monotonicS is seconds relative to the continuous recording segment, not device uptime. Ordering is non-decreasing only within each (segmentId, stream), including across chunks at finish. Different streams may arrive out of order, and new segments may reset elapsed time. Legacy unlabelled mixed-stream timestamps are retained. simulation stream requires simulated source. UUID identifiers are case-insensitive and canonicalized to lowercase before database/filesystem use."
      }
    },
